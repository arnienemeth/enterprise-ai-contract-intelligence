# Azure OpenAI configuration — copy this file to `.env` and fill in your values.
# Do NOT put a real key here. Real secrets go in `.env` only (which is gitignored).
# If a key ever leaks, rotate it in the Azure Portal.

AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embedding-test
