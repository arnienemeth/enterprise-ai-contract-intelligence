# --- Secrets ---
.env
.env.*
!.env.example

# --- Python ---
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# --- Vector store ---
# The seed vector_db is committed so the deployed demo has data on first load.
# (Regenerate anytime with: python reindex.py --reset)
vector_store/*.pkl
vector_store/*.index

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*
*.tmp

# --- Logs / outputs ---
logs/*.log
outputs/*

# --- Legacy duplicates ---
*" - Copy"*
* - Copy*.py
